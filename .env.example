# =============================================================================
# TAUROS Cognitive OS — template .env (copia in .env e personalizza)
# Genera token forte:  tauros init --owner "Nome" --allowlist "C:\path\workspace"
# =============================================================================

TAUROS_NAME=TAUROS
TAUROS_OWNER=Owner
TAUROS_HOST=127.0.0.1
TAUROS_PORT=8000

# Token API operatore (OBBLIGATORIO, forte). Non usare change-me-now.
TAUROS_API_TOKEN=

TAUROS_DATABASE_PATH=./data/tauros.db
TAUROS_BACKUP_DIR=./data/backups

# Provider: ollama | groq | openai | openai-compatible
TAUROS_PROVIDER=groq
TAUROS_MODEL=openai/gpt-oss-20b

# Groq — https://console.groq.com/keys
TAUROS_GROQ_API_KEY=
TAUROS_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama locale
TAUROS_OLLAMA_URL=http://127.0.0.1:11434

# OpenAI / gateway compatibili
TAUROS_OPENAI_BASE_URL=https://api.openai.com/v1
TAUROS_OPENAI_API_KEY=

# Sicurezza: locked | read_only | supervised
TAUROS_SECURITY_MODE=read_only

# Percorsi autorizzati (virgola o ;). Fuori = negato.
TAUROS_WORKSPACE_ALLOWLIST=
# Zone di fiducia (meno frizione sulle scritture supervisionate)
TAUROS_TRUST_ZONES=
TAUROS_WORKSPACE_BLOCKLIST=

# Elevazione privilegi
TAUROS_ELEVATION_DEFAULT_MINUTES=15
TAUROS_ELEVATION_MAX_MINUTES=60
TAUROS_ELEVATION_STRONG_PHRASE=CONFERMO ADMIN

# Rete: solo loopback di default
TAUROS_ALLOW_LAN_BIND=false
TAUROS_ALLOW_PUBLIC_BIND=false
TAUROS_CORS_ORIGINS=null,http://127.0.0.1:8000,http://localhost:8000
TAUROS_PUBLIC_BASE_URL=

# Limiti
TAUROS_MAX_FILE_BYTES=2000000
TAUROS_MAX_TOOL_OUTPUT_CHARS=100000
TAUROS_MAX_TOOL_STEPS=8
TAUROS_MAX_PLAN_STEPS=3
TAUROS_MAX_SAME_TOOL_CALLS=3
TAUROS_TOOL_TIMEOUT_SECONDS=30
TAUROS_LOG_LEVEL=INFO
TAUROS_GUEST_MAX_MESSAGES=20
TAUROS_ALLOW_OPEN_REGISTRATION=true

# Telegram (opzionale)
TAUROS_TELEGRAM_BOT_TOKEN=
TAUROS_TELEGRAM_ENABLED=false

# Planner LLM (true = ibrido regole+modello)
TAUROS_LLM_PLANNER=true

# --- Produzione pubblica (esempio, solo dietro HTTPS) ---
# TAUROS_HOST=0.0.0.0
# TAUROS_ALLOW_PUBLIC_BIND=true
# TAUROS_PUBLIC_BASE_URL=https://tauros.tuodominio.com
# TAUROS_CORS_ORIGINS=https://tauros.tuodominio.com


# Accessi di sviluppo: abilitare solo esplicitamente su una macchina fidata.
TAUROS_LOCAL_CLICK_LOGIN=false
TAUROS_OTP_DEBUG=false
